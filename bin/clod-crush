#!/bin/env bash
# Start a clod session with Crush. Equivalent to running `clod` with
# CLOD_TOOL=crush: persists the tool choice to .clod/tool for this
# directory and switches it to crush if it was on something else
# (e.g. claude).
set -euo pipefail
export CLOD_TOOL=crush
exec "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/clod" "$@"
